# Copy to .env and fill in your own values.  Never commit .env.

# Required in practice: a long random string.  Generates with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable auth (only safe bound to 127.0.0.1).
SOLVER_API_KEY=

# "solver" runs headful Chrome under Xvfb inside the image.
HEADLESS=false

# Seconds a request waits for the shared browser before getting 429 busy.
SOLVER_QUEUE_TIMEOUT=120

LOG_LEVEL=INFO

# Host port the API is published on.  Bound to loopback on purpose.
SOLVER_PORT=8000

# Optional extra Chromium switches, comma separated.
# CHROME_ARGS=--disable-dev-shm-usage,--window-size=1280,900